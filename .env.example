# ============================================================
# 环境变量示例：复制成 .env 后按需修改（.env 已被 .gitignore 忽略）
#
# 命名约定：STOCK_ 前缀 + 字段名大写（snake_case），对应 apps/api/src/config/settings.py
# 的 Settings 字段（pydantic-settings，环境变量优先级 > .env > 代码默认值）。
# ============================================================

# ------------------------------------------------------------------
# 1) 数据源
# ------------------------------------------------------------------
# 通达信 hsjday 日线数据根目录（.day 二进制文件所在目录）。
# 目录结构约定：{根}/{sh|sz|bj}/lday/{市场}{6位代码}.day
#   - 怎么获取：通达信客户端导出本地日线数据，或从已有备份复制过来
#   - 不填会怎样：用代码默认值 ~/Desktop/每日复盘/hsjday；若该目录不存在，
#     指标/选股/回测接口会 404/空结果。没有真实数据时用脚本生成演示数据：
#         .venv/bin/python scripts/seed_demo_data.py
#     然后把本变量指向生成的 data/demo_hsjday
STOCK_HSJDAY_ROOT=~/Desktop/每日复盘/hsjday

# ------------------------------------------------------------------
# 2) 概览页快照
# ------------------------------------------------------------------
# 概览页（首页）读取的离线快照 JSON 路径，由 scripts/make_dashboard_snapshot.py
# 生成（各策略信号数/选择性/超额胜率 + 市场基线），避免每次加载首页都全市场扫描。
#   - 怎么获取：跑 scripts/make_dashboard_snapshot.py（真实数据约 30 分钟）
#     或 scripts/seed_demo_data.py（演示数据秒级）
#   - 不填会怎样：用仓库内默认 data/dashboard_snapshot.json（由上面的脚本生成，
#     data/ 已被 .gitignore 忽略、不入库）；文件缺失时首页降级为空、不报错
STOCK_DASHBOARD_SNAPSHOT_PATH=

# ------------------------------------------------------------------
# 3) 跨域
# ------------------------------------------------------------------
# 允许跨域访问 API 的前端来源（JSON 数组）。
#   - 什么时候改：前端不在 3000 端口（例如部署到域名）时加上对应来源
#   - 不填会怎样：用默认 ["http://localhost:3000"]，其他来源的浏览器请求会被 CORS 拦
STOCK_CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------------
# 4) 调度器
# ------------------------------------------------------------------
# 报告输出目录：FileNotifier 把每日选股/扫描报告写成 Markdown 落到这里。
#   - 不填会怎样：用默认 ~/Desktop/stock-platform/reports；目录不存在时 FileNotifier
#     会创建，写不进就静默降级（不阻塞任务）
STOCK_SCHEDULER_REPORT_DIR=~/Desktop/stock-platform/reports

# 飞书自定义机器人 webhook URL（WebhookNotifier 用）。绝不硬编码进代码/仓库。
#   - 怎么获取：飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 webhook 地址
#   - 不填会怎样：webhook 渠道静默降级为「只写本地报告文件、不发飞书」，任务照常跑
STOCK_FEISHU_WEBHOOK_URL=

# ------------------------------------------------------------------
# 5) 一致性验证脚本（scripts/verify_top5_consistency.py）
# ------------------------------------------------------------------
# 旧脚本选股历史 JSON 路径（只读，用于对比「次日命中率」口径）。
#   - 不填会怎样：用默认 ~/.openclaw/workspace/tools/stock_pick_history.json；
#     文件不存在时脚本打印「未找到选股历史」并正常退出
STOCK_PICK_HISTORY=~/.openclaw/workspace/tools/stock_pick_history.json
