# ============================================================
# 环境变量示例：复制成 .env 后按需修改（.env 已被 .gitignore 忽略）
# 命名约定：STOCK_ 前缀 + 字段名大写，对应 config/settings.py
# ============================================================

# 通达信 hsjday 日线数据根目录（默认值已写进代码，这里可覆盖）
STOCK_HSJDAY_ROOT=~/Desktop/每日复盘/hsjday

# 允许跨域的前端来源（JSON 数组格式）
STOCK_CORS_ORIGINS=["http://localhost:3000"]

# 调度器：报告输出目录（FileNotifier 写 Markdown 到这里）
STOCK_SCHEDULER_REPORT_DIR=~/Desktop/stock-platform/reports

# 调度器：飞书自定义机器人 webhook URL（WebhookNotifier 用，绝不硬编码；
# 留空则 webhook 渠道静默降级为不发送，只写本地报告文件）
# 获取方式：飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 webhook 地址
STOCK_FEISHU_WEBHOOK_URL=
